PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:MAT_KHAU@localhost:5432/cinemind?schema=public"
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=doi-thanh-chuoi-ngau-nhien-dai
JWT_REFRESH_SECRET=doi-thanh-chuoi-ngau-nhien-khac
# Điền mã + khóa của tài khoản VNPay sandbox. Chưa có thì dùng tạm giá trị giả để chạy cổng mô phỏng (/dev/payments/.../simulate).
VNP_TMN_CODE=DEMO0001
VNP_HASH_SECRET=demo-secret-chi-dung-khi-dev
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/payment/result
# Cổng giả lập thanh toán /dev (đánh dấu đơn ĐÃ TRẢ mà không cần đăng nhập). Chỉ bật khi phát triển/demo; production bắt buộc xóa dòng này.
ENABLE_DEV_ROUTES=true
# Khi chạy sau proxy (Nginx...) đặt số bước nhảy proxy, vd 1, để giới hạn tốc độ tính đúng IP khách.
# TRUST_PROXY=1

# --- Trợ lý AI (docs/07). Để trống = trợ lý tắt. KHÔNG commit khóa thật; chỉ đặt trong file .env cục bộ. ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5          # đổi sang claude-sonnet-5-5 để rẻ hơn khoảng một nửa
# AI_EFFORT=low                     # low | medium | high | xhigh | max
# AI_REFUSAL_FALLBACK=true          # bộ lọc an toàn từ chối thì tự chạy lại trên mô hình dự phòng
