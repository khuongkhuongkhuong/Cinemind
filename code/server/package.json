{
  "name": "cinemind-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "test": "node --env-file=.env --test \"tests/**/*.test.js\"",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:clean-test": "node --env-file=.env scripts/clean-test-data.js",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:demo": "node --env-file=.env scripts/seed-demo-orders.js",
    "spike:seatlock": "node --env-file=.env scripts/spike-seatlock.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  }
}
