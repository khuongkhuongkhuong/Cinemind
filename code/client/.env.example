# Địa chỉ API. Để trống: dùng '/api/v1' qua proxy của Vite (khuyến nghị khi dev).
# Khi build triển khai thật, đặt địa chỉ đầy đủ nếu API khác tên miền: https://api.example.com/api/v1
VITE_API_URL=

# Backend mà proxy của Vite trỏ tới (mặc định http://localhost:4000)
# VITE_PROXY_TARGET=http://localhost:4000

# true: dùng dữ liệu giả (MSW) thay vì backend thật — để làm giao diện khi backend chưa chạy
VITE_ENABLE_MOCK=false

# true: nút Thanh toán gọi cổng GIẢ LẬP của backend (cần ENABLE_DEV_ROUTES=true ở backend) thay vì chuyển sang VNPay.
# Dùng để chạy trọn luồng đặt vé khi chưa có tài khoản VNPay. CHỈ có tác dụng ở chế độ dev, bản build không bao giờ dùng.
VITE_PAYMENT_SIMULATOR=false
